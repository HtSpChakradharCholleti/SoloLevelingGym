{
  "name": "sololevelinggym",
  "version": "1.4.0",
  "main": "expo-router/entry",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "start": "expo start",
    "start:local": "expo start",
    "start:production": "NODE_ENV=production expo start",
    "android": "expo run:android",
    "android:local": "expo run:android",
    "android:production": "NODE_ENV=production expo run:android --variant release",
    "build:local": "cd android && ./gradlew assembleRelease",
    "build:production": "cd android && NODE_ENV=production ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest-expo --config ./jest.config.js",
    "test:watch": "jest-expo --config ./jest.config.js --watch",
    "test:coverage": "jest-expo --config ./jest.config.js --coverage",
    "test:harness": "rn-harness run",
    "test:harness:ios": "rn-harness run --platform ios",
    "test:harness:android": "rn-harness run --platform android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@hot-updater/react-native": "0.30.3",
    "@op-engineering/op-sqlite": "^18.0.0",
    "@shopify/react-native-skia": "^2.6.4",
    "expo": "~55.0.8",
    "expo-asset": "~55.0.10",
    "expo-audio": "~55.0.9",
    "expo-constants": "~55.0.17",
    "expo-device": "~55.0.10",
    "expo-document-picker": "~55.0.13",
    "expo-font": "~55.0.4",
    "expo-linear-gradient": "^55.0.9",
    "expo-linking": "~55.0.16",
    "expo-location": "~55.1.14",
    "expo-notifications": "~55.0.13",
    "expo-router": "~55.0.17",
    "expo-sharing": "~55.0.20",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.10",
    "expo-task-manager": "~55.0.20",
    "prop-types": "^15.8.1",
    "react": "19.2.0",
    "react-native": "0.83.4",
    "react-native-device-info": "^15.0.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-nitro-modules": "^0.35.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@hot-updater/expo": "0.29.6",
    "@react-native-harness/platform-android": "^1.4.1",
    "@react-native-harness/platform-apple": "^1.4.1",
    "@react-native-harness/ui": "^1.4.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-react-compiler": "^19.0.0-beta-af1b7da-20250417",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "expo-build-properties": "~55.0.14",
    "hot-updater": "0.29.6",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.16",
    "patch-package": "^8.0.1",
    "react-native-harness": "^1.4.1",
    "react-test-renderer": "19.2.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  }
}
